{
  "name": "posandbox",
  "version": "0.1.0",
  "description": "Visual lab of virtual POS devices. First device: Epson TM-T20III ESC/POS network printer.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server/main.ts",
    "dev": "node --watch src/server/main.ts & vite",
    "build": "vite build",
    "test": "node --test --test-timeout=20000 'src/**/*.test.ts'",
    "typecheck": "tsc -p . && tsc -p src/web",
    "e2e": "docker compose -f e2e/compose.yaml up --build --force-recreate --renew-anon-volumes --abort-on-container-exit --exit-code-from e2e; code=$?; docker compose -f e2e/compose.yaml down -v >/dev/null 2>&1; exit $code",
    "cli": "node src/cli/main.ts"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@playwright/test": "1.63.0",
    "@point-of-sale/receipt-printer-encoder": "^4.0.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@react-three/postprocessing": "^3.1.3",
    "@types/node": "^24",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "6.1.1",
    "bwip-js": "^4.11.4",
    "iconv-lite": "^0.7.3",
    "postprocessing": "^6.39.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "zustand": "^5.0.15"
  },
  "packageManager": "pnpm@12.4.2",
  "bin": {
    "posandbox": "src/cli/main.ts"
  }
}
